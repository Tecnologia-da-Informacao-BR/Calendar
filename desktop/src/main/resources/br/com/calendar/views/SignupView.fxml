<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.shape.Rectangle?>

<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="br.com.calendar.controllers.SignupController"
      fx:id="root"
      styleClass="signup-root">

    <!-- ===== Left panel (branding) ===== -->
    <VBox fx:id="brandPanel" styleClass="brand-panel" alignment="TOP_CENTER" HBox.hgrow="ALWAYS">
        <padding>
            <Insets top="60" right="40" bottom="0" left="40"/>
        </padding>

        <!-- ===== Superior space ===== -->
        <Region minHeight="20"/>

        <!-- ===== Title ===== -->
        <Label text="Project A" styleClass="brand-title"/>

        <!-- ===== Description ===== -->
        <Label styleClass="brand-description" wrapText="true"
            text="Entre em um mundo de clareza e produtividade calma. Gerencie sua carga cognitiva com nossa interface livre de distrações, projetada para o profissional moderno."/>

        <!-- ===== Cards ===== -->
        <HBox styleClass="feature-row" spacing="20" alignment="CENTER">
            <padding>
                <Insets top="30" bottom="30" left="0" right="0"/>
            </padding>
            <VBox styleClass="feature-card" spacing="7" alignment="CENTER_LEFT" rotate="-3.01">
                <Label text="🗓" styleClass="feature-icon"/>
                <Label text="Agendamento Fluido" styleClass="feature-text" wrapText="true"/>
            </VBox>
            <VBox styleClass="feature-card" spacing="7" alignment="CENTER_LEFT" rotate="3.01">
                <Label text="⚡" styleClass="feature-icon"/>
                <Label text="Foco Instantâneo" styleClass="feature-text" wrapText="true"/>
            </VBox>
        </HBox>

        <Region VBox.vgrow="ALWAYS"/>

        <!-- ===== Footer background ===== -->
        <StackPane fx:id="brandDecorativeFooter" styleClass="brand-decorative-footer" prefHeight="260" minHeight="200">
            <ImageView fx:id="brandBackgroundImage" preserveRatio="false" smooth="true" fitWidth="10000" fitHeight="260">
                <image>
                    <Image url="@../images/brand_background.jpg" backgroundLoading="true"/>
                </image>
                <clip>
                    <Rectangle width="1000" height="260"/>
                </clip>
            </ImageView>
            <Region styleClass="brand-decorative-overlay"/>
        </StackPane>
    </VBox>

    <!-- ===== Right panel ===== -->
    <StackPane HBox.hgrow="ALWAYS" styleClass="form-panel">
        <VBox styleClass="form-content" maxWidth="480" alignment="TOP_LEFT" spacing="12">
            <padding>
                <Insets top="40" right="50" bottom="20" left="50"/>
            </padding>

            <!-- ===== Header ===== -->
            <Label text="Junte-se ao movimento" styleClass="form-title" minWidth="-Infinity"/>
            <Label text="Crie seu centro de produtividade profissional hoje mesmo."
                styleClass="form-subtitle" wrapText="true" minWidth="-Infinity"/>

            <!-- Name -->
            <VBox spacing="4">
                <Label text="NOME COMPLETO" styleClass="field-label"/>
                <HBox styleClass="input-wrapper" alignment="CENTER_LEFT">
                    <Label text="👤" styleClass="input-icon"/>
                    <TextField fx:id="nameField" promptText="Estefânio"
                            styleClass="input-inner" HBox.hgrow="ALWAYS"/>
                </HBox>
                <Label fx:id="nameErrorLabel" styleClass="error-label" managed="false" visible="false"/>
            </VBox>

            <!-- Email -->
            <VBox spacing="4">
                <Label text="ENDEREÇO DE E-MAIL" styleClass="field-label"/>
                <HBox styleClass="input-wrapper" alignment="CENTER_LEFT">
                    <Label text="✉" styleClass="input-icon"/>
                    <TextField fx:id="emailField" promptText="exemplo@projeto-a.com"
                            styleClass="input-inner" HBox.hgrow="ALWAYS"/>
                </HBox>
                <Label fx:id="emailErrorLabel" styleClass="error-label" managed="false" visible="false"/>
            </VBox>

            <!-- Password / Confirm Password -->
            <HBox spacing="14">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="SENHA" styleClass="field-label"/>
                    <HBox styleClass="input-wrapper" alignment="CENTER_LEFT">
                        <Label text="🔒" styleClass="input-icon"/>
                        <PasswordField fx:id="passwordField" promptText="Senha"
                                    styleClass="input-inner" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <Label fx:id="passwordErrorLabel" styleClass="error-label" managed="false" visible="false"/>
                </VBox>

                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="CONFIRMAR SENHA" styleClass="field-label"/>
                    <HBox styleClass="input-wrapper" alignment="CENTER_LEFT">
                        <Label text="✓" styleClass="input-icon"/>
                        <PasswordField fx:id="passwordConfirmationField" promptText="Confirmar senha"
                                    styleClass="input-inner" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <Label fx:id="passwordConfirmationErrorLabel" styleClass="error-label" managed="false" visible="false"/>
                </VBox>
            </HBox>

            <!-- ===== General error ===== -->
            <Label fx:id="generalErrorLabel" styleClass="error-label general-error" managed="false" visible="false"/>

            <!-- Terms -->
            <HBox spacing="9" alignment="CENTER_LEFT">
                <CheckBox fx:id="termsCheckBox" styleClass="terms-checkbox"/>
                <TextFlow styleClass="terms-text">
                    <Text text="Eu concordo com os "/>
                    <Hyperlink fx:id="termsLink" text="Termos e Condições" styleClass="inline-link"/>
                    <Text text=" e com a "/>
                    <Hyperlink fx:id="privacyLink" text="Política de Privacidade" styleClass="inline-link"/>
                    <Text text="."/>
                </TextFlow>
            </HBox>

            <!-- Primary button -->
            <Button fx:id="signupButton" text="Criar Conta" styleClass="primary-button"
                    maxWidth="Infinity" onAction="#handleSignup"/>

            <!-- Divider -->
            <HBox alignment="CENTER" spacing="14">
                <Separator HBox.hgrow="ALWAYS"/>
                <Label text="OU REGISTRE-SE COM" styleClass="divider-label"/>
                <Separator HBox.hgrow="ALWAYS"/>
            </HBox>

            <!-- Social login buttons -->
            <HBox spacing="16">
                <Button fx:id="googleLoginButton" text="Google" styleClass="social-button"
                        HBox.hgrow="ALWAYS" maxWidth="Infinity" onAction="#handleGoogleSignup"
                        contentDisplay="LEFT" graphicTextGap="8">
                    <graphic>
                        <ImageView fitWidth="18" fitHeight="18" preserveRatio="true">
                            <image>
                                <Image url="@../images/google_logo.png"/>
                            </image>
                        </ImageView>
                    </graphic>
                </Button>

                <Button fx:id="githubLoginButton" text="GitHub" styleClass="social-button"
                        HBox.hgrow="ALWAYS" maxWidth="Infinity" onAction="#handleGithubSignup"
                        contentDisplay="LEFT" graphicTextGap="8">
                    <graphic>
                        <ImageView fitWidth="18" fitHeight="18" preserveRatio="true">
                            <image>
                                <Image url="@../images/github_logo.png"/>
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
            </HBox>

            <!-- Login link -->
            <HBox alignment="CENTER" spacing="5">
                <Label text="Já tem uma conta?" styleClass="footer-text"/>
                <Hyperlink fx:id="loginLink" text="Entrar" styleClass="inline-link" onAction="#handleGoToLogin"/>
            </HBox>

            <!-- Copyright -->
            <Region VBox.vgrow="ALWAYS"/>
            <HBox alignment="CENTER">
                <Label text="© 2026 Project A. Todos os direitos reservados." styleClass="copyright-label"/>
            </HBox>
        </VBox>
    </StackPane>

</HBox>