<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="br.com.calendar.controllers.LoginController"
        fx:id="root"
        prefWidth="1280"
        prefHeight="1024"
        styleClass="login-root">

    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <HBox fx:id="loginCard" 
        styleClass="login-card"
        prefWidth="1200"
        prefHeight="648"
        maxWidth="1200" 
        maxHeight="648">


        <!-- ===== Left panel (branding) ===== -->
        <VBox fx:id="brandPanel" 
            styleClass="login-brand-panel"
            prefWidth="600"
            minWidth="0"
            HBox.hgrow="ALWAYS">

            <padding>
                <Insets top="40" right="48" bottom="40" left="48"/>
            </padding>

        <!-- Logo + name -->
            <HBox spacing="12" 
                alignment="CENTER_LEFT">

                <StackPane styleClass="login-logo-badge">

                    <FontIcon iconLiteral="mdi2c-calendar" 
                        styleClass="login-logo-icon"/>

                </StackPane>

                <Label text="Project A" 
                    styleClass="login-brand-name"/>
            </HBox>

            <Region minHeight="48" VBox.vgrow="NEVER"/>

            <!-- Headline -->
            <TextFlow maxWidth="380">

                <Text fx:id="headlineMain"
                    styleClass="login-headline"
                    text="Confirme sua identidade"/>
                

            </TextFlow> 

            <Region minHeight="20" VBox.vgrow="NEVER"/>

            <!-- Description -->
            <TextFlow maxWidth="380">
                <Text styleClass="login-description"
                    text="Insira o código de verificação enviado para o seu e-mail para continuar com segurança."/>
            </TextFlow>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Tip card -->
            <HBox styleClass="login-tip-card" 
                spacing="14" 
                alignment="CENTER_LEFT">

                <StackPane styleClass="login-tip-icon-circle">

                    <FontIcon iconLiteral="mdi2a-auto-fix" 
                        styleClass="login-tip-icon"/>

                </StackPane>

                <VBox spacing="2">

                    <Label text="VERIFICAÇÃO DE E-MAIL" 
                        styleClass="login-tip-label"/>

                    <Label text="Verifique sua caixa de entrada e insira o código de 6 dígitos." 
                        styleClass="login-tip-text" 
                        wrapText="true"/>

                </VBox>
            </HBox>
        </VBox>

        <!-- ===== Right panel (form) ===== -->
        <StackPane fx:id="formPanel" 
            styleClass="login-form-panel" 
            HBox.hgrow="ALWAYS"
            prefWidth="600"
            minWidth="0" 
            alignment="CENTER">

            <VBox fx:id="formContent" 
                styleClass="login-form-content" 
                alignment="TOP_LEFT" 
                spacing="18">

                <padding>
                    <Insets top="50" right="0" bottom="0" left="0"/>
                </padding>

                <VBox spacing="6">

                    <Label text="Verificar OTP" 
                        styleClass="form-title"/>

                    <Label text="Insira o código de 6 dígitos enviado para o seu e-mail." 
                        styleClass="form-subtitle"/>

                    <padding>
                        <Insets top="0" right="0" bottom="30" left="0"/>
                    </padding>

            </VBox>

            <!-- General error placeholder -->
            <Label fx:id="generalErrorLabel" 
                styleClass="error-label general-error" 
                managed="false" 
                visible="false"/>

            <!-- OTP field -->
            <VBox spacing="6">

                    <Label text="CÓDIGO OTP" 
                        styleClass="field-label"/>

                    <HBox styleClass="input-wrapper" 
                        alignment="CENTER_LEFT">

                        <FontIcon iconLiteral="mdi2e-email-outline" 
                            styleClass="input-icon"/>

                        <TextField fx:id="otpField" 
                            promptText="000000"
                            styleClass="input-inner, otp-input" 
                            HBox.hgrow="ALWAYS"/>

                    </HBox>
                    <Label fx:id="otpErrorLabel" 
                        styleClass="error-label" 
                        managed="false" 
                        visible="false"/>

                </VBox>
            
            <Button fx:id="verifyButton" 
                text="Verificar OTP" 
                styleClass="primary-button"
                maxWidth="Infinity" 
                onAction="#handleVerify"/>

                <VBox spacing="8">

                    <HBox alignment="CENTER" spacing="5">

                        <Label text="Lembrou sua senha?" 
                            styleClass="footer-text" 
                            HBox.hgrow="ALWAYS"
                            maxWidth="Infinity"/>

                        <Hyperlink fx:id="loginLink" 
                            text="Voltar para o login" 
                            styleClass="inline-link"
                            onAction="#handleGoToLogin"/>


                        <Hyperlink fx:id="forgotPasswordLink" 
                            text="Esqueceu a senha?"
                            styleClass="inline-link" 
                            onAction="#handleGoToForgotPassword"/>

                    </HBox>

                    <HBox alignment="CENTER" 
                        spacing="5">

                        <Label text="Quer redefinir a senha?" 
                            styleClass="footer-text"/>

                        <Hyperlink fx:id="resetPasswordLink" 
                            text="Redefinir senha" 
                            styleClass="inline-link"
                            onAction="#handleGoToResetPassword"/>
                    </HBox>
                </VBox>
                
                <Region minHeight="10"/>

                <HBox alignment="CENTER">

                    <padding>
                        <Insets top="0" right="0" bottom="20" left="0"/>
                    </padding>

                    <Label text="© 2026 Project A. Gestão profissional de horários." 
                    styleClass="copyright-label"/>


                </HBox>
            </VBox>
        </StackPane>

    </HBox>
</StackPane>
    